# Copy this file to .env for native development (docker-compose reads
# these too if you create a real .env - see docker-compose.yml).
# All values below are safe placeholders - never commit a real .env file.

# ---------------------------------------------------------------------------
# Server port
# ---------------------------------------------------------------------------
# Single-container/production port (Docker, Railway). The backend serves
# both the API and the built frontend on this port.
PORT=3000

# Native development only: the backend's own port when the Vite dev server
# is running separately on its default port 3000. Leave unset to use the
# built-in default of 3001 (must match the vite.config.ts dev proxy target).
# BACKEND_PORT=3001

# ---------------------------------------------------------------------------
# Deployment mode
# ---------------------------------------------------------------------------
# local  - full multi-Gateway support; users may register any Gateway
#          host/IP from the UI. Intended for engineers running this on
#          their own machine/network.
# hosted - restricts the app to a single pre-approved Gateway (see
#          CAMPUS_CONTROLLER_URL below) and refuses arbitrary custom
#          Gateway targets, to avoid turning a public deployment into an
#          open SSRF proxy. Auto-detected when Railway environment
#          variables are present; set explicitly to override.
APP_MODE=local

# Explicit override for whether custom Gateway targets are allowed,
# regardless of APP_MODE. Only set this to true in hosted mode if you have
# specifically evaluated and accepted the SSRF risk.
# ALLOW_CUSTOM_GATEWAYS=false

# ---------------------------------------------------------------------------
# Legacy / hosted Gateway bootstrap
# ---------------------------------------------------------------------------
# When set, the server registers a single locked Gateway profile pointing
# at this URL on startup (preserves the previous single-Gateway Railway
# deployment behavior). Not required for local mode - add Gateways from
# the UI instead.
# CAMPUS_CONTROLLER_URL=https://gateway.example.local

# ---------------------------------------------------------------------------
# Gateway profile storage
# ---------------------------------------------------------------------------
# Where non-secret Gateway connection metadata (name/host/port/protocol) is
# persisted as JSON. Credentials are NEVER written here - see
# server/credentials.js and the README "Credentials" section.
# GATEWAY_STORE_PATH=./data/gateways.json
